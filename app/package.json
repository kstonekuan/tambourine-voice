{
	"name": "tambourine-voice",
	"version": "0.1.0",
	"type": "module",
	"description": "Your personal voice interface for any app",
	"scripts": {
		"dev": "tauri dev",
		"dev:vite": "vite",
		"build": "tauri build",
		"build:vite": "vite build",
		"lint": "biome check --write",
		"typecheck": "tsc --noEmit",
		"knip": "knip",
		"test": "vitest run --reporter=dot",
		"test:watch": "vitest",
		"cargo:clippy": "cargo clippy --all-targets --all-features --locked --manifest-path src-tauri/Cargo.toml",
		"cargo:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
		"cargo:test": "cargo test --quiet --locked --manifest-path src-tauri/Cargo.toml",
		"cargo:check": "pnpm run cargo:clippy && pnpm run cargo:fmt && pnpm run cargo:test",
		"cargo:upgrade": "cargo upgrade --manifest-path src-tauri/Cargo.toml",
		"cargo:update": "cargo update --manifest-path src-tauri/Cargo.toml",
		"update": "pnpm update --latest && pnpm run cargo:upgrade && pnpm run cargo:update",
		"check": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm test && pnpm run cargo:check",
		"tauri": "tauri"
	},
	"author": "kstonekuan",
	"license": "AGPL-3.0",
	"dependencies": {
		"@daily-co/daily-js": "^0.95.0",
		"@mantine/core": "^9.7.5",
		"@mantine/hooks": "^9.7.5",
		"@mantine/notifications": "^9.7.5",
		"@pipecat-ai/client-js": "^1.16.0",
		"@pipecat-ai/client-react": "^1.11.0",
		"@pipecat-ai/small-webrtc-transport": "^1.11.2",
		"@pipecat-ai/voice-ui-kit": "^0.14.2",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/react-query": "^5.107.1",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-fs": "^2.7.1",
		"@tauri-apps/plugin-opener": "^2.7.2",
		"@tauri-apps/plugin-os": "^2.4.0",
		"@tauri-apps/plugin-store": "^2.5.0",
		"@use-gesture/react": "^10.3.1",
		"@xstate/react": "^6.1.0",
		"date-fns": "^4.4.0",
		"ky": "^2.2.0",
		"lucide-react": "^1.70.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-hotkeys-hook": "^5.3.3",
		"tailwindcss": "4.3.5",
		"ts-pattern": "^5.9.2",
		"xstate": "^5.33.4",
		"zod": "4.6.7",
		"zustand": "5.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@tauri-apps/cli": "2.12.4",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.2.1",
		"knip": "6.44.2",
		"typescript": "7.0.2",
		"vite": "8.3.6",
		"vite-plugin-svgr": "5.2.0",
		"vitest": "5.1.0"
	}
}
